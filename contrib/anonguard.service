[Unit]
Description=AnonGuard Research-Grade Anonymity Gateway
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/Un-9oon/AnonGuard

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/bin/anonguard-daemon --listen 127.0.0.1:9050 --onion --quantum --enforce-subnet-diversity
Restart=on-failure
RestartSec=5s

# Security and Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
