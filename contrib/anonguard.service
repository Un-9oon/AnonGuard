[Unit]
Description=Experimental AnonGuard Transport
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/Un-9oon/AnonGuard

[Service]
Type=simple
DynamicUser=yes
StateDirectory=anonguard
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/anonguard/runtime.env
ExecStart=/usr/bin/anonguard-daemon --listen 127.0.0.1:9050 --onion --enforce-subnet-diversity --identity-key-path /var/lib/anonguard/identity.key --guard-state-path /var/lib/anonguard/guards.json $ANONGUARD_ARGS
Restart=on-failure
RestartSec=5s

# Security and Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=4096
LimitCORE=0
TasksMax=256
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
CPUQuota=200%
# Initial laptop gateway budgets; measure before increasing for larger deployments.
# These limits apply to this daemon, not separately launched protected applications.

[Install]
WantedBy=multi-user.target
