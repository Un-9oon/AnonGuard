[Unit]
Description=AnonGuard Node (High Security Profile)
After=network.target

[Service]
Type=simple
User=anonguard
Group=anonguard
# Default assumes deployment as a middle/exit node on standard ports. Adjust args as needed.
# Bug #14: fixed --role exit (non-existent flag) -> --relay --is-exit
ExecStart=/usr/local/bin/anonguard-daemon --relay --is-exit --listen 0.0.0.0:9050

# Bug #14: flush nftables rules on graceful stop so no stale drop rules remain
ExecStopPost=/usr/bin/nft delete table inet anonguard_filter

# Prevent logging to disk to protect user anonymity
StandardOutput=null
StandardError=null

# Forensic & Security Hardening Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

# Ensure the kernel doesn't swap sensitive keys or packet buffers to disk
LimitCORE=0
# Requires Swap setup disabled globally for full effect, but this helps prevent localized memory dumps

[Install]
WantedBy=multi-user.target
